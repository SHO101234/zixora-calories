<?xml version="1.0" encoding="utf-8"?>
<!-- Blue/teal banner: deep blue -> teal gradient, teal border -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="#0D47A1"
        android:centerColor="#1565C0"
        android:endColor="#00897B" />
    <stroke android:width="2dp" android:color="#4DB6AC" />
    <corners android:radius="20dp" />
</shape>
