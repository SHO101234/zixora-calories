<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/cream">

    <!-- Thadingyut banner: gradient card, pulsing lanterns, sweeping light streak -->
    <FrameLayout
        android:id="@+id/bannerBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/banner_bg"
        android:padding="14dp">
        <View
            android:id="@+id/streakView"
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:rotation="20"
            android:background="@drawable/light_streak" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/lanternLeft"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_lantern"
                android:contentDescription="ဆီမီး" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="ဒီနေ့ ကယ်လိုရီ"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />
            <ImageView
                android:id="@+id/lanternRight"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_lantern"
                android:contentDescription="ဆီမီး" />
        </LinearLayout>
    </FrameLayout>

    <!-- အဓိက မြင်ကွင်း: စားပြီး / ပန်းတိုင် / ကျန် — တစ်ချက်ကြည့်ရုံနဲ့ သိရတယ် -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp"
        android:background="@drawable/summary_card_bg"
        android:padding="18dp"
        android:elevation="6dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="စားပြီး"
                    android:textSize="16sp"
                    android:textColor="@color/ink_soft" />
                <TextView
                    android:id="@+id/txtEaten"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 kcal"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/orange" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ပန်းတိုင်"
                    android:textSize="16sp"
                    android:textColor="@color/ink_soft" />
                <TextView
                    android:id="@+id/txtTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2000 kcal"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/maroon" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/txtRemain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:background="@drawable/remain_pill"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="ကျန် 2000 kcal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="12dp"
            android:max="2000"
            android:progress="0"
            android:progressTint="@color/orange"
            android:progressBackgroundTint="@color/gold_light" />
        <TextView
            android:id="@+id/txtSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="14sp"
            android:textColor="@color/ink_soft" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAddPreset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/gold"
        android:textColor="@android:color/white"
        android:elevation="6dp"
        android:text="🍜  စာရင်းထဲက အစားအစာ ထည့်မယ်"
        android:textSize="18sp" />
    <Button
        android:id="@+id/btnAddCustom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/orange"
        android:textColor="@android:color/white"
        android:elevation="6dp"
        android:text="✏️  အစားအစာအသစ် ထည့်မယ်"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="ဒီနေ့ စားထားတာတွေ"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/deep_brown" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/entryList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom nav: fixed 56dp bar, all three tabs exactly equal height, no overlap -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:background="@color/maroon">
        <Button
            android:id="@+id/btnMyFoods"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:minHeight="0dp"
            android:padding="0dp"
            android:backgroundTint="@color/gold"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:text="ကိုယ့်စာရင်း" />
        <Button
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:minHeight="0dp"
            android:padding="0dp"
            android:backgroundTint="@color/orange"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:text="ကိုယ်ရေးအချက်အလက်" />
        <Button
            android:id="@+id/btnGuide"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:minHeight="0dp"
            android:padding="0dp"
            android:backgroundTint="@color/maroon"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:text="လမ်းညွှန်" />
    </LinearLayout>
</LinearLayout>
