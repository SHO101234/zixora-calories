<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_lantern"
            android:contentDescription="ဆီမီး" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="ဒီနေ့ ကယ်လိုရီ"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/deep_brown" />
        <ImageView
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_lantern"
            android:contentDescription="ဆီမီး" />
    </LinearLayout>

    <!-- အဓိက မြင်ကွင်း: စားပြီး / ပန်းတိုင် / ကျန် — တစ်ချက်ကြည့်ရုံနဲ့ သိရတယ် -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        style="@style/CardStyle">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="စားပြီး"
                    android:textSize="16sp"
                    android:textColor="@color/ink_soft" />
                <TextView
                    android:id="@+id/txtEaten"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 kcal"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ပန်းတိုင်"
                    android:textSize="16sp"
                    android:textColor="@color/ink_soft" />
                <TextView
                    android:id="@+id/txtTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2000 kcal"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/txtRemain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="ကျန် 2000 kcal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/orange" />
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="2000"
            android:progress="0" />
        <TextView
            android:id="@+id/txtSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="@color/ink_soft" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAddPreset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="🍜  စာရင်းထဲက အစားအစာ ထည့်မယ်"
        android:textSize="18sp" />
    <Button
        android:id="@+id/btnAddCustom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="✏️  အစားအစာအသစ် ထည့်မယ်"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="ဒီနေ့ စားထားတာတွေ"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/deep_brown" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/entryList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnMyFoods"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="ကိုယ့်စာရင်း" />
        <Button
            android:id="@+id/btnProfile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="ကိုယ်ရေးအချက်အလက်" />
        <Button
            android:id="@+id/btnGuide"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="လမ်းညွှန်" />
    </LinearLayout>
</LinearLayout>
